# Copy this file to .env.local and fill in your own values. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Never prefix with NEXT_PUBLIC_ and never paste into browser code.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Optional: shown on the admin Settings page.
NEXT_PUBLIC_SUPPORT_EMAIL=
