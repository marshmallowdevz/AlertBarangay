# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# --- Next.js app (repo root) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only secret key (Supabase > Project Settings > API Keys).
# Never prefix it with NEXT_PUBLIC_ and never use it in browser code.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Optional: support mailbox shown on the admin Settings page.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Server-only key for the resident AI assistant (free at aistudio.google.com > Get API key).
# Optional: without it the assistant still works, answering from built-in
# English/Filipino/Cebuano help instead of the AI model.
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-2.5-flash).
GEMINI_MODEL=

# --- Vite resident app (resident-app/) ---
VITE_SUPABASE_URL=https://lemnfqjyrhirjnfukfrm.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_REQUIRE_AUTH=true
